{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Preconstruct Design System Tokens",
  "version": "1.0.0",
  "description": "Neo-minimalist shell + compact-maximalist data tokens for Preconstruct construction tooling",
  "color": {
    "pantone": {
      "cloudDancer": {
        "name": "Cloud Dancer",
        "code": "PANTONE 11-4201",
        "hex": "#F0EEE9",
        "description": "Pantone Color of the Year 2026 - Clean, warm off-white canvas"
      },
      "mochaMousse": {
        "name": "Mocha Mousse",
        "code": "PANTONE 17-1230",
        "hex": "#A47864",
        "description": "Pantone 2025 - Natural earthen tone, construction material aesthetic"
      }
    },
    "shell": {
      "paper": "#F0EEE9",
      "sheet": "#FBFAF7",
      "sheetElevated": "#FFFFFF",
      "ink": "#1F1D1A",
      "graphite": "#6B665E",
      "graphiteFaint": "#9E988F",
      "rule": "#DDD8CF",
      "ruleSubtle": "#EBE7DF",
      "mocha": "#A47864",
      "mochaDeep": "#7A5545",
      "mochaTint": "rgba(164, 120, 100, 0.12)",
      "mochaGlow": "rgba(164, 120, 100, 0.24)"
    },
    "provenance": {
      "measured": {
        "base": "#3E6B57",
        "tint": "rgba(62, 107, 87, 0.12)",
        "label": "Measured",
        "meaning": "Derived directly from deterministic vector geometry & CAD scaling"
      },
      "read": {
        "base": "#3C5A7A",
        "tint": "rgba(60, 90, 122, 0.12)",
        "label": "Read",
        "meaning": "Extracted from vector text or high-confidence OCR tokens"
      },
      "look": {
        "base": "#B5832A",
        "tint": "rgba(181, 131, 42, 0.14)",
        "label": "Needs a look",
        "meaning": "Model inference, uncalibrated scale, or human verification required"
      },
      "void": {
        "base": "#A6402F",
        "tint": "rgba(166, 64, 47, 0.12)",
        "label": "Void / Missing",
        "meaning": "Missing parameter, broken reference, or out-of-bounds formula"
      }
    },
    "trades": {
      "supply": "#D93872",
      "return": "#2EA043",
      "exhaust": "#E66E19",
      "freshAir": "#0EA5E9",
      "chilledWater": "#567A32",
      "drain": "#2563EB",
      "equipment": "#8B5CF6",
      "fireDamper": "#DC2626"
    }
  },
  "typography": {
    "fontFamilies": {
      "sans": "'Inter Tight', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
      "mono": "'JetBrains Mono', 'SF Mono', Consolas, monospace"
    },
    "sizes": {
      "display": { "fontSize": "32px", "lineHeight": "38px", "letterSpacing": "-0.03em" },
      "heroNumber": { "fontSize": "28px", "lineHeight": "32px", "letterSpacing": "-0.02em" },
      "h1": { "fontSize": "20px", "lineHeight": "26px", "letterSpacing": "-0.02em" },
      "h2": { "fontSize": "16px", "lineHeight": "22px", "letterSpacing": "-0.01em" },
      "body": { "fontSize": "13px", "lineHeight": "18px" },
      "bodyCompact": { "fontSize": "12px", "lineHeight": "16px" },
      "label": { "fontSize": "11px", "lineHeight": "14px", "letterSpacing": "0.04em", "textTransform": "uppercase" },
      "micro": { "fontSize": "9.5px", "lineHeight": "12px", "letterSpacing": "0.02em" }
    }
  },
  "spacing": {
    "unit": "4px",
    "comfortable": {
      "rowHeight": "36px",
      "panelPadding": "20px",
      "cellPadding": "8px 12px",
      "gap": "16px"
    },
    "compact": {
      "rowHeight": "28px",
      "panelPadding": "14px",
      "cellPadding": "4px 8px",
      "gap": "10px"
    }
  },
  "radii": {
    "sm": "3px",
    "md": "6px",
    "lg": "10px",
    "full": "9999px"
  },
  "borders": {
    "hairline": "1px solid #DDD8CF",
    "hairlineSubtle": "1px solid #EBE7DF",
    "focus": "1.5px solid #A47864"
  },
  "motion": {
    "easing": "cubic-bezier(0.2, 0.7, 0.2, 1)",
    "duration": {
      "fast": "140ms",
      "normal": "220ms",
      "deliberate": "380ms",
      "scan": "1800ms"
    }
  }
}
